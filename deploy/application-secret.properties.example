# 数据源敏感配置外置模板
# 用法：复制为 /u1/tomcat/conf/snapshot/application.properties，填入真实账号口令，chmod 600。
# Tomcat 启动时通过 bin/setenv.sh 注入：
#   CATALINA_OPTS="$CATALINA_OPTS -Dspring.config.additional-location=file:/u1/tomcat/conf/snapshot/"
# 该文件会与 war 内的 application.properties 合并，且优先级更高。

# ========== 数据源1: ecology ==========
spring.datasource.primary.driver-class-name=oracle.jdbc.OracleDriver
spring.datasource.primary.jdbc-url=jdbc:oracle:thin:@192.168.0.81:1521:TOPPRD
spring.datasource.primary.username=CHANGEME
spring.datasource.primary.password=CHANGEME
# ========== 数据源2: dsdata ==========
spring.datasource.second.driver-class-name=oracle.jdbc.OracleDriver
spring.datasource.second.jdbc-url=jdbc:oracle:thin:@192.168.0.81:1521:TOPPRD
spring.datasource.second.username=CHANGEME
spring.datasource.second.password=CHANGEME
# ========== 数据源3: mysql ==========
spring.datasource.third.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.third.jdbc-url=jdbc:mysql://192.168.0.83:3306/sdm?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
spring.datasource.third.username=CHANGEME
spring.datasource.third.password=CHANGEME
